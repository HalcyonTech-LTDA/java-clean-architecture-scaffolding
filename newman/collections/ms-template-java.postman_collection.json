{
  "info": {
    "_postman_id": "7f8e9d0a-1b2c-3d4e-5f6a-7b8c9d0e1f2a",
    "name": "ms-template-java API Test Suite",
    "description": "Comprehensive Newman/Postman automated test suite for ms-template-java microservice.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
